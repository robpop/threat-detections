<group name="sigma,">
    <!-- Author: Robert Popeleski -->
    <rule id="100100" level="5">
        <!-- Description: A failed MFA attempt -->
        <if_sid>87801, 87802, 87803</if_sid>
        <field name="azure.resultType" type="pcre2">(?i)^500121$</field>
        <description>EntraID MFA Failure</description>
        <options>no_full_log</options>
        <group>azure,signinlogs,</group>
        <mitre>
            <id>T1621</id>
        </mitre>
    </rule>
    <rule id="100101" level="5">
        <!-- Description: A successful sign-in was performed -->
        <if_sid>87801, 87802, 87803</if_sid>
        <field name="azure.resultType" type="pcre2">(?i)^0$</field>
        <field name="azure.properties.authenticationRequirement" type="pcre2">(?i)^multiFactorAuthentication$</field>
        <field name="azure.properties.status.additionalDetails" negate="yes" type="pcre2">(?i)satisfied\ by\ claim\ in\ the\ token</field>
        <description>Successful Sign-In</description>
        <options>no_full_log</options>
        <group>azure,signinlogs,</group>
    </rule>
    <rule id="100102" level="10" frequency="5" timeframe="600">
        <!-- Description: Repeated MFA failures (5 ct.) were observed (over 10m timeframe) -->
        <if_matched_sid>100100</if_matched_sid>
        <same_field>azure.properties.userPrincipalName</same_field>
        <same_field>azure.properties.ipAddress</same_field>
        <description>Repeated MFA Failures for a User</description>
        <group>azure,signinlogs,mfa_fatigue,</group>
        <mitre>
            <id>T1621</id>
        </mitre>
    </rule>
    <rule id="100103" level="12" timeframe="1200">
        <!-- Description: Possible MFA fatigue followed by a successful sign-in -->
        <!-- Check events matching rule 100101 (a successful sign-in w/ MFA satisfied) -->
        <if_sid>100101</if_sid>
        <!-- Rule 100102 must have fired within the 1200s (20min) timeframe before 100101 -->
        <if_matched_sid>100102</if_matched_sid>
        <!-- Where same UPN and IP address -->
        <same_field>azure.properties.userPrincipalName</same_field>
        <same_field>azure.properties.ipAddress</same_field>
        <description>MFA Fatigue Followed by Successful Sign-In</description>
        <group>azure,signinlogs,mfa_fatigue,</group>
        <mitre>
            <id>T1621</id>
            <id>T1078.004</id>
        </mitre>
    </rule>
</group>