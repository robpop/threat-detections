// Author: Robert Popeleski
// MFA fatigue: 5+ MFA failures (500121) from one IP, followed by a successful
// MFA-satisfied sign-in from the same IP shortly after the last failure.
let mfaThreshold = 5;                       // failures required BEFORE the success
let failureLookback = 20m;                  // only count failures this long before the success
let maxGapAfterLastFailure = 10m;           // success must follow the last failure within this gap
let Failures = SigninLogs                   // get failed sign-ins as Failures
| where ResultType == "500121"              // failed strong-authentication step (denied / no response)
| project
    UserId,
    IPAddress,
    FailureTime = TimeGenerated,
    MfaDetail = tostring(Status.additionalDetails);
let Successes = SigninLogs                                                          // get successful sign-ins as Successes
| where ResultType == "0"                                                           // successful sign-ins only
| where AuthenticationRequirement == "multiFactorAuthentication"                    // the success satisfied MFA (the user approved a prompt)
| where tostring(Status.additionalDetails) !has "satisfied by claim in the token"   // exclude MFA satisfied by existing token
| extend IsAnonymousIP =
    tostring(RiskEventTypes_V2) has "anonymizedIPAddress"
    or tostring(RiskEventTypes) has "anonymizedIPAddress"
| project
    UserId,
    IPAddress,
    SuccessTime = TimeGenerated,
    Upn = tolower(UserPrincipalName),
    AppDisplayName,
    ClientAppUsed,
    Location,
    IsAnonymousIP,
    RiskLevelDuringSignIn,
    RiskEventTypes_V2,
    CorrelationId;
Successes
| join kind=inner Failures on UserId, IPAddress                     // combine (join) failed and successful sign-ins where user AND IP are the same
| project-away UserId1, IPAddress1                                  // KQL adds a number i.e., "1" to duplicate columns - remove these two duplicate columns
| where FailureTime < SuccessTime                                   // only failures BEFORE the success (time of failure occurs before the successful sign-in)
    and FailureTime >= SuccessTime - failureLookback                // where the failure occured within 20 minutes of the successful sign-in (not after, or too long before > 20m)
| summarize
    MfaFailureCount = count(),
    FirstFailure = min(FailureTime),
    LastFailure = max(FailureTime),                                 // max() - in other words, the largest TimeGenerated for all failures
    FailureDetails = make_set(MfaDetail, 10),
    take_any(Upn, AppDisplayName, ClientAppUsed, Location, IsAnonymousIP,
             RiskLevelDuringSignIn, RiskEventTypes_V2, CorrelationId)
    by UserId, IPAddress, SuccessTime
| where MfaFailureCount >= mfaThreshold                             // threshold met before the success
| where SuccessTime - LastFailure <= maxGapAfterLastFailure         // success came soon after the last failure (within 10m) - a successful sign-in shortly after a failure is a stronger indicator than just a success with failures within the failureLookback (20m) 
| summarize arg_min(SuccessTime, *) by UserId, IPAddress            // one alert per user and IP: the first qualifying success
| extend TimeToCompromiseMinutes = datetime_diff('minute', SuccessTime, FirstFailure)
| project
    TimeGenerated = SuccessTime,
    UserId,
    UserPrincipalName = Upn,
    SuccessIP = IPAddress,
    MfaFailureCount,
    FailureDetails,
    FirstFailure,
    LastFailure,
    Location,
    AppDisplayName,
    ClientAppUsed,
    IsAnonymousIP,
    RiskLevelDuringSignIn,
    RiskEventTypes_V2,
    TimeToCompromiseMinutes,
    CorrelationId
// Example:
// Failures at 09:36, 09:38, 09:40. Success at 09:55.
// All three are within 20 minutes, so they fall within failureLookback. But the last failure was 15 minutes before the
// success, which is more than 10, does not satisfy maxGapAfterLastFailure. In this case, the failures stopped, there was a pause, then a
// success. That could be a user who remembered their password after a short break rather than an adversary who gained access.
